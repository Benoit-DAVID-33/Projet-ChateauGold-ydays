FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend backend
COPY frontend frontend

WORKDIR /app/backend

ENV PYTHONUNBUFFERED=1
ENV API_BASE_URL=http://api:5001

EXPOSE 5000

# Serveur ASGI granian (Rust) : plusieurs workers = plusieurs processus,
# donc plusieurs GIL et un vrai parallelisme pour les sous-processus FFmpeg.
CMD ["granian", "--interface", "asgi", "--host", "0.0.0.0", "--port", "5000", "--workers", "2", "main:app"]
