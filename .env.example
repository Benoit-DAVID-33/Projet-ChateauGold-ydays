# Clé secrète des sessions (OBLIGATOIRE en production).
# Générer une valeur aléatoire, ex. : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-par-une-cle-aleatoire

# API externe de traitement (défaut : http://localhost:5001)
API_BASE_URL=http://localhost:5001

# Email (formulaire de contact) — mot de passe d'application Gmail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application
CONTACT_RECIPIENT=ricardo.mbesob@ynov.com

# Kling AI (optionnel)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE_URL=https://api.klingai.com

# URL publique pour Omni-Video (vidéo locale -> Kling). Ex. ngrok : https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# Sessions / uploads
# Passer à true derrière HTTPS en production
SESSION_HTTPS_ONLY=false
MAX_UPLOAD_MB=500

# --- Proxy multi-fournisseurs (LLM / génération) ---
# Ordre de priorité des fournisseurs (le routeur choisit le premier éligible)
LLM_PROVIDER_PRIORITY=kling,huggingface,local,minimax
# Quotas quotidiens par fournisseur (vide = illimité). Ex : kling=100,huggingface=1000
LLM_QUOTAS=
LLM_TIMEOUT_SECONDS=60

# Hugging Face Inference (routeur compatible API OpenAI) — ex. MiniMax, Qwen...
HF_API_BASE_URL=https://router.huggingface.co/v1
HF_API_TOKEN=
HF_MODEL=MiniMaxAI/MiniMax-M2

# LLM local (Ollama, vLLM, llama.cpp) exposé en API compatible OpenAI
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_API_KEY=local

# MiniMax (API compatible OpenAI pour le texte)
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_API_KEY=

# --- Emoji (studio backend) ---
# URLs CDN essayées dans l'ordre ({lang} = en/fr) ; EMOJI_DATA_FILE court-circuite le réseau
EMOJI_DATA_URLS=https://cdn.jsdelivr.net/npm/emojibase-data@latest/{lang}/data.json,https://cdn.jsdelivr.net/npm/emojibase-data/{lang}/compact.json,https://unpkg.com/emojibase-data@latest/{lang}/compact.json
EMOJI_DATA_FILE=
EMOJI_CACHE_TTL=86400
EMOJI_MAX_RESULTS=120
