# =============================================================================
# GOLD FX — configuration (copier en .env ; ne JAMAIS committer .env)
# Toutes les variables applicatives sont préfixées GOLDFX_.
# =============================================================================

# --- Application -------------------------------------------------------------
# production | development | test. En production, l'API refuse de démarrer si
# la clé secrète est faible ou si les cookies ne sont pas « Secure ».
GOLDFX_ENVIRONMENT=production
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
GOLDFX_SECRET_KEY=
# URL publique (HTTPS) de l'application : nécessaire pour Kling Omni-Video
# (Kling télécharge la vidéo source via un lien signé temporaire).
GOLDFX_PUBLIC_BASE_URL=https://goldfx.example.com
GOLDFX_COOKIE_SECURE=true
GOLDFX_LOG_LEVEL=INFO
GOLDFX_WORKERS=2

# --- Base de données (compose) ------------------------------------------------
POSTGRES_DB=goldfx
POSTGRES_USER=goldfx
POSTGRES_PASSWORD=
# Hors compose, renseigner directement :
# GOLDFX_DATABASE_URL=postgresql://user:password@host:5432/goldfx

# --- Médias -------------------------------------------------------------------
GOLDFX_MAX_IMAGE_MB=25
GOLDFX_MAX_VIDEO_MB=500

# --- Kling AI (https://app.klingai.com/global/dev) -----------------------------
GOLDFX_KLING_ACCESS_KEY=
GOLDFX_KLING_SECRET_KEY=
GOLDFX_KLING_BASE_URL=https://api.klingai.com
# GOLDFX_KLING_IMAGE_MODEL=kling-v1
# GOLDFX_KLING_VIDEO_MODEL=kling-v1
# GOLDFX_KLING_OMNI_MODEL=kling-video-o1
# Suivi de fond des générations (0 : désactivé) et abandon après N heures
# GOLDFX_GENERATION_SWEEP_SECONDS=30
# GOLDFX_GENERATION_MAX_AGE_HOURS=24

# --- Service de traitement externe ---------------------------------------------
# echo : traitement factice intégré (renvoie le média) ; http : votre API IA
# respectant le contrat POST /process-video (multipart) et POST /process-query.
GOLDFX_PROCESSOR_BACKEND=echo
# GOLDFX_PROCESSOR_URL=http://processor:5001

# --- Emails (formulaire de contact) -------------------------------------------
# console : les emails sont seulement journalisés (logs du conteneur api) ;
# smtp : envoi réel (recommandé en production).
GOLDFX_MAIL_BACKEND=console
# Destinataire des messages du formulaire de contact (obligatoire en production).
GOLDFX_CONTACT_RECIPIENT=contact@goldfx.example.com
GOLDFX_MAIL_FROM=noreply@goldfx.example.com
GOLDFX_SMTP_HOST=smtp.gmail.com
GOLDFX_SMTP_PORT=587
GOLDFX_SMTP_USERNAME=
# Gmail : utiliser un « mot de passe d'application », jamais le mot de passe du compte.
GOLDFX_SMTP_PASSWORD=
GOLDFX_SMTP_STARTTLS=true

# --- Exposition ----------------------------------------------------------------
GOLDFX_HTTP_PORT=8080
